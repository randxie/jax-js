{
  "name": "@jax-js/jax",
  "version": "0.1.11",
  "description": "Numerical computing and ML in the browser",
  "keywords": [
    "machine learning",
    "jax",
    "numpy",
    "numerical computing"
  ],
  "author": {
    "name": "Eric Zhang",
    "email": "ekzhang1@gmail.com",
    "url": "https://www.ekzhang.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekzhang/jax-js.git"
  },
  "type": "module",
  "files": [
    "/dist/*.{js,cjs,d.ts,d.cts}"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/index.d.ts": {
      "import": "./dist/index.d.ts",
      "require": "./dist/index.d.cts"
    }
  },
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "build:watch": "TSDOWN_WATCH_MODE=1 tsdown",
    "check": "tsc",
    "docs": "tsx typedoc.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "funasr:export-encoder": ".venv/bin/python scripts/export_funasr_nano_encoder.py",
    "funasr:export-llm": ".venv/bin/python scripts/export_funasr_nano_llm.py",
    "funasr:verify-e2e": "tsx scripts/verify_funasr_nano_e2e.ts",
    "funasr:verify-audio": "tsx scripts/verify_funasr_nano_audio.ts",
    "funasr:verify-browser": "tsx scripts/verify_funasr_nano_browser.ts",
    "funasr:verify-frontend": "tsx scripts/verify_funasr_nano_frontend.ts",
    "funasr:verify-prepare": "tsx scripts/verify_funasr_nano_prepare.ts",
    "funasr:verify-tokenizer": "tsx scripts/verify_funasr_nano_tokenizer.ts",
    "funasr:transcribe": ".venv/bin/python scripts/verify_funasr_nano_transcription.py",
    "funasr:verify-sample-audio": "tsx scripts/verify_funasr_nano_audio.ts --audio .download/Fun-ASR-Nano-2512/example/zh.mp3 --expected-text 开饭时间早上九点至下午五点。",
    "funasr:verify-sample-transcript": ".venv/bin/python scripts/verify_funasr_nano_transcription.py --audio .download/Fun-ASR-Nano-2512/example/zh.mp3 --expected-text 开饭时间早上九点至下午五点。",
    "funasr:verify-encoder": "pnpm build && tsx scripts/run_funasr_nano_encoder.ts",
    "lint": "eslint",
    "test": "vitest",
    "test:coverage": "vitest run --coverage && open coverage/index.html",
    "prepublishOnly": "pnpm build",
    "postpublish": "git tag jax/v$npm_package_version && git push --tags"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/debug": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@webgpu/types": "^0.1.68",
    "eslint": "^9.31.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.0.0",
    "playwright": "~1.58.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "tsdown": "^0.13.2",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.14",
    "typedoc-theme-fresh": "^0.2.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@tensorflow/tfjs-core>@webgpu/types": "^0.1.68"
    }
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "overrides": [
      {
        "files": [
          "*.md"
        ],
        "options": {
          "printWidth": 100
        }
      }
    ],
    "proseWrap": "always"
  }
}
